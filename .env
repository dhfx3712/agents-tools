# 数据库连接配置（核心，替换以下占位符为实际数据库信息）
DB_TYPE=mysql
DB_HOST=127.0.0.1  # 替换为实际数据库IP（如服务器IP）
DB_PORT=3306       # 数据库端口，默认3306
DB_USER=root       # 数据库用户名
#DB_PASS=your_password  # 替换为实际数据库密码
DB_NAME=polaris_db # 数据库名称（需提前创建）
DB_TABLE=fact_polaris_daily # 核心事实表名称

# OpenClaw SQL生成规则（固定，无需修改）
OPENCLAW_SQL_AUTO_EXECUTE=false  # 禁止自动执行SQL，必须人工复核
OPENCLAW_RETURN_SQL_FIRST=true   # 指令优先返回SQL，不直接返回结果
OPENCLAW_SQL_TEMPLATE_PATH=/root/.openclaw/workspace-static/templates  # SQL模板存储路径（需提前创建该文件夹）

# 语义层配置文件路径（固定，与下文YAML文件路径一致）
SEMANTIC_CONFIG_PATH=/root/.openclaw/workspace-static/semantic_polaris.yaml

# 日志配置（可选，用于排查问题）
LOG_LEVEL=INFO
LOG_PATH=/root/.openclaw/workspace-static/logs
